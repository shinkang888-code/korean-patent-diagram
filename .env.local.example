# =============================================
# 한국 특허 플랫폼 환경변수
# =============================================

# Neon PostgreSQL 연결 문자열
# https://console.neon.tech 에서 발급
DATABASE_URL=postgresql://username:password@host.neon.tech/neondb?sslmode=require

# KIPRIS Plus Open API 키
# https://plus.kipris.or.kr 에서 무료 발급
KIPRIS_API_KEY=your_kipris_api_key_here

# 다음 줄을 .env.local 파일로 복사하고 실제 값 입력:
# cp .env.local.example .env.local
